/* Night theme: dim dark surfaces so the screen does not blind at night.
   The default (default_style.qss) is the light theme for sunlight. */

QWidget {
    background-color: #1b1f25;
    color: #e6e8eb;
}
QMenuBar, QMenu, QStatusBar {
    background-color: #15181d;
    color: #e6e8eb;
}
QMenuBar::item:selected, QMenu::item:selected {
    background-color: #2d4a7a;
}
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QTextEdit, QPlainTextEdit,
QListView, QTreeView, QTableView, QAbstractScrollArea {
    background-color: #232830;
    color: #e6e8eb;
    border: 1px solid #3a424d;
}
QComboBox QAbstractItemView {
    background-color: #232830;
    selection-background-color: #2d4a7a;
}
QPushButton, QToolButton {
    background-color: #2a3038;
    color: #e6e8eb;
    border: 1px solid #444c56;
    border-radius: 4px;
    padding: 3px 8px;
}
QPushButton:hover, QToolButton:hover {
    background-color: #333a44;
}
QPushButton:checked, QToolButton:checked {
    background-color: #2d4a7a;
}
QTabWidget::pane {
    border: 1px solid #3a424d;
}
QTabBar::tab {
    background-color: #232830;
    color: #c3cad2;
    padding: 6px 10px;
    border: 1px solid #3a424d;
}
QTabBar::tab:selected {
    background-color: #1b1f25;
    color: #e6e8eb;
    border-bottom: 2px solid #6ea8ff;
}
QHeaderView::section {
    background-color: #232830;
    color: #e6e8eb;
    border: 0;
    padding: 4px;
}
QToolTip {
    background-color: #2a3038;
    color: #e6e8eb;
    border: 1px solid #6ea8ff;
}

LockButton {
    qproperty-color_idle: #d0151515;
    qproperty-color_hover: #d0303030;
    qproperty-color_pressed: #d0000000;
    qproperty-size: 48;
}

WindIndicator {
    qproperty-arrow_color: #ff6b5b;
    qproperty-pen_color: #e6e8eb;
    qproperty-background_color: #e61b1f25;
    qproperty-size: 40;
}

MiniStrip {
    qproperty-size: 30;
}

MapWidget {
    qproperty-color_background: #202020;
    qproperty-ac_arrow_size: 50;
    qproperty-show_hidden_waypoints: false;
}

/* Strips: a frame when links are lost, the battery voltage in amber or red */
#mini_strip QLabel {
    background: transparent;
}
#mini_strip[link="warning"] {
    border: 3px solid #d9a03f;
    background: #2a2214;
}
#mini_strip[link="lost"] {
    border: 3px solid #ff6b5b;
    background: #3a1a18;
}
#mini_strip QLabel[bat="low"] {
    color: #f2c46d;
    font-weight: bold;
}
#mini_strip QLabel[bat="critic"] {
    color: #ff8a80;
    font-weight: bold;
}

/* Flight plan blocks: selected (tapped) and current block */
QPushButton#block_row {
    border: 0;
    border-radius: 0;
    padding: 0 8px;
    min-height: 40px;
    background: transparent;
    text-align: left;
}
QPushButton#block_row QLabel {
    background: transparent;
}
QPushButton#block_row:checked {
    background: #1f2b3d;
    border-left: 4px solid #6ea8ff;
}
QPushButton#block_row[current="true"] {
    background: #1d3526;
    border-left: 4px solid #4cc274;
}
QPushButton#block_row[current="true"] QLabel {
    color: #d7f5df;
    font-weight: bold;
}
QPushButton#block_go {
    background: #3b74d6;
    color: white;
    font-weight: bold;
    border: 0;
    border-radius: 5px;
    padding: 0 14px;
    min-height: 30px;
}
