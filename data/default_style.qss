
/* Buttons on the map */
/* the rail of panel buttons on the left of the map */
#map_rail {
    background: #22272e;
}
LockButton {
    qproperty-color_idle: #ff22272e;
    qproperty-color_hover: #ff3a4350;
    qproperty-color_pressed: #ff14171c;
    qproperty-color_active: #ff1d5fc9;
    qproperty-size: 48;
}

WindIndicator {
    qproperty-arrow_color: #ff0000;
    qproperty-pen_color: #202020;
    qproperty-background_color: #e6ffffff;
    qproperty-size: 40;
}

MiniStrip {
    qproperty-size: 30;
}

MapWidget {
    qproperty-color_background: #404040;
    qproperty-ac_arrow_size: 50;
    qproperty-show_hidden_waypoints: false;
}


/* Window: light gray menu and status bar, white right column (like the mockup) */
QMenuBar {
    background: #f4f5f7;
    border-bottom: 1px solid #d8dde3;
}
QMenuBar::item {
    background: transparent;
    padding: 4px 10px;
}
QMenuBar::item:selected {
    background: #dde7f7;
}
QMenu {
    background: #ffffff;
    border: 1px solid #c4ccd5;
}
QMenu::item {
    padding: 6px 24px 6px 12px;
}
QMenu::item:selected {
    background: #dde7f7;
    color: #111418;
}
QStatusBar {
    background: #f4f5f7;
    border-top: 1px solid #d8dde3;
}
QSplitter::handle {
    background: #d8dde3;
}
#right_pane QWidget {
    background-color: #ffffff;
}
#right_pane QPushButton {
    background-color: #f4f5f7;
    border: 1px solid #c4ccd5;
    border-radius: 4px;
    padding: 3px 10px;
}
#right_pane QPushButton:hover {
    background-color: #e8ecf0;
}
#right_pane QPushButton:checked {
    background-color: #dde7f7;
}

/* Default theme: light, for outdoor use in sunlight (dark text, strong status colors).
   night_style.qss is the dark alternative (Settings > General > Style). */

/* Strips: a frame when links are lost, the battery voltage in amber or red */
#mini_strip {
    border: 1px solid #c4ccd5;
    border-radius: 6px;
    background: #ffffff;
}
#mini_strip QLabel {
    background: transparent;
}
#mini_strip QLabel#caption {
    color: #30363d;
}
#mini_strip QLabel#status_text {
    color: #b42318;
    font-weight: bold;
}
#mini_strip[selected="true"] {
    border: 2px solid #1d5fc9;
    background: #f5f8fd;
}
#mini_strip[link="warning"] {
    border: 3px solid #c27c0e;
    background: #fff4e0;
}
#mini_strip[link="lost"] {
    border: 3px solid #b42318;
    background: #fde8e6;
}
#mini_strip QLabel[bat="low"] {
    color: #8a4b00;
    font-weight: bold;
}
#mini_strip QLabel[bat="critic"] {
    color: #b42318;
    font-weight: bold;
}

/* Flight plan blocks: selected (tapped) and current block */
QPushButton#block_row {
    border: 0;
    border-radius: 0;
    padding: 0 8px;
    min-height: 40px;
    background: transparent;
    text-align: left;
}
QPushButton#block_row QLabel {
    background: transparent;
}
QPushButton#block_row QLabel#block_detail {
    color: #57606a;
}
QPushButton#block_row:checked {
    background: #dde7f7;
    border-left: 4px solid #1d5fc9;
}
QPushButton#block_row[current="true"] {
    background: #cfe9d6;
    border-left: 4px solid #1f7a3f;
}
QPushButton#block_row[current="true"] QLabel {
    color: #0b3d1c;
    font-weight: bold;
}
QPushButton#block_go {
    background: #1d5fc9;
    color: white;
    font-weight: bold;
    border: 0;
    border-radius: 5px;
    padding: 0 14px;
    min-height: 30px;
}

/* Tabs: flat, the selected one underlined */
QTabWidget::pane {
    border: 0;
    border-top: 1px solid #c4ccd5;
}
QTabBar::tab {
    background: transparent;
    border: 0;
    padding: 8px 12px;
    color: #30363d;
}
QTabBar::tab:hover {
    color: #111418;
}
QTabBar::tab:selected {
    color: #111418;
    font-weight: bold;
    border-bottom: 2px solid #1d5fc9;
}

/* Settings: a row per setting, the value on the aircraft (amber until a sent value is confirmed) */
#setting_row {
    border-bottom: 1px solid #e3e7ec;
}
#setting_row QLabel#setting_name {
    font-weight: bold;
}
#setting_row QLabel#setting_unit, #setting_row QLabel#setting_group_label {
    color: #57606a;
}
QPushButton#setting_value {
    font-family: "Monospace";
    background-color: #f4f5f7;
    border: 1px solid #c4ccd5;
    border-radius: 4px;
    padding: 3px 8px;
    min-width: 48px;
}
QPushButton#setting_value[pending="true"] {
    background-color: #fff4e0;
    border: 2px solid #c27c0e;
    color: #8a4b00;
    font-weight: bold;
}
QToolButton#setting_action {
    background: transparent;
    border: 0;
    border-radius: 4px;
    min-width: 28px;
    min-height: 28px;
    font-size: 15px;
}
QToolButton#setting_action:hover {
    background-color: #eef2f6;
}
QPushButton#setting_group {
    text-align: left;
    background-color: #ffffff;
    border: 0;
    border-bottom: 1px solid #d8dde3;
    border-radius: 0;
    padding: 10px 8px;
    font-weight: bold;
}
QPushButton#setting_group:hover {
    background-color: #eef2f6;
}
